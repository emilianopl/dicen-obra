# Copiar a .env y arrancar con: node --env-file=.env server.js
PORT=8080
# apilado (pausa arriba / play abajo, audio de 4 canales) o mitades (pausa y play uno después del otro)
DICEN_FORMATO=apilado
DICEN_TOGGLE_DEBOUNCE_MS=400
DICEN_HARD_SEEK_S=1.0
DICEN_DEADBAND_S=0.03
DICEN_GAIN=0.5
DICEN_MAX_RATE_DELTA=0.05
DICEN_CORRECTION_MS=500
DICEN_CLOCK_SYNC_MS=5000
