# Servicio systemd para el servidor de Dicen (Linux).
# Instalar: ajustar User y WorkingDirectory, copiar a /etc/systemd/system/ y correr
#   sudo systemctl enable --now dicen
[Unit]
Description=Dicen - servidor de sincronización
After=network-online.target
Wants=network-online.target

[Service]
User=dicen
WorkingDirectory=/home/dicen/dicen-obra
ExecStart=/usr/bin/env node server.js
EnvironmentFile=-/home/dicen/dicen-obra/.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
